[Unit]
Description=Kasir Web Laravel Backend
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/kasir-web/backend
ExecStart=/usr/bin/php artisan serve --host=127.0.0.1 --port=8080
Restart=always
RestartSec=3

StandardOutput=append:/var/log/kasir-backend.log
StandardError=append:/var/log/kasir-backend-error.log

[Install]
WantedBy=multi-user.target
